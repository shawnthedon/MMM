# SwarmOS configuration — copy to `.env` (never commit real secrets)
# ---------------------------------------------------------------------------

# ---- Gateway ----
PORT=8787
DATA_DIR=./data

# Authentication mode:
#   required  (default) — every data route needs a session cookie or bearer token
#   dev-open            — anonymous callers are accepted as SWARMOS_DEV_ROLE (local only;
#                         refused automatically when NODE_ENV=production)
SWARMOS_AUTH=required
# SWARMOS_DEV_ROLE=Operator

# Secret used to derive CSRF tokens and HMACs. Generate with: openssl rand -base64 48
# If unset, one is generated once and stored in the settings table.
# SWARMOS_AUTH_SECRET=

# First-start owner bootstrap (required in production, optional in development where a
# generated password is printed once):
# SWARMOS_BOOTSTRAP_EMAIL=owner@example.com
# SWARMOS_BOOTSTRAP_PASSWORD=change-me-please-123

# Session and lockout tuning
# SWARMOS_SESSION_TTL_MS=43200000      # 12 h
# SWARMOS_LOGIN_WINDOW_MS=300000       #  5 min
# SWARMOS_LOGIN_MAX_FAILURES=5
# SWARMOS_LOCKOUT_MS=900000            # 15 min
# SWARMOS_MIN_PASSWORD=12

# Set to 1 behind TLS termination so the session cookie is marked Secure.
# SWARMOS_SECURE_COOKIES=1

# Browser origins allowed to send credentials (comma separated, exact match, no wildcards)
# SWARMOS_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Request limits
# SWARMOS_BODY_LIMIT=262144
# SWARMOS_RATE_LIMIT=600

# Seeding demo data is blocked in production unless this is 1
# SWARMOS_ALLOW_SEED=0

# ---- PWA ----
# Gateway URL baked into the build. Leave empty to ship in demo mode (the app then offers
# "Configure gateway" at runtime). Use a path such as "/" when a reverse proxy serves the
# gateway on the same origin as the app.
# VITE_GATEWAY_URL=https://swarmos.example.com
