{
  "name": "swarmos-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SwarmOS \u2014 mobile-first AI Agent Orchestration Dashboard. Deploy agent teams & swarms, skills, MCP plugins, multi-model routing, trust & governance. Installable PWA.",
  "homepage": "https://zippy-ivory-4ei6zjy.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/shawnthedon/MMM.git"
  },
  "bugs": {
    "url": "https://github.com/shawnthedon/MMM/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-orchestration",
    "swarm",
    "openclaw",
    "mcp",
    "pwa",
    "mobile-first",
