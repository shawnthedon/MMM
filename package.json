  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:gateway": "node apps/gateway/server.js",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node apps/gateway/src/seed.js",
    "export-fixtures": "node scripts/export-fixtures.mjs",
    "audit:verify": "node -e \"import('./apps/gateway/src/db.js').then(m=>console.log(m.verifyAuditChain()))\"",
    "icons": "node scripts/gen-icons.mjs",
    "smoke": "node --import ./scripts/register-css-stub.mjs scripts/smoke.mjs",
    "test": "npm run smoke && npm run test:copilot && npm run test:auth && npm run test:readsync && npm run test:designer && npm run test:skills && npm run test:comms && npm run test:design && npm run test:responsive && npm run test:local && npm run test:local-runtime && npm run test:isolation && npm run test:kanban && npm run test:scroll && npm run test:comms-gateway && npm run test:gateway && npm run test:session-safety && npm run test:sw-safety && npm run test:provider-safety && npm run test:comms-persistence && npm run test:training-jsonl && npm run test:voice",
    "test:copilot": "node --import ./scripts/register-css-stub.mjs scripts/copilot-tour.mjs",
    "test:auth": "node --import ./scripts/register-css-stub.mjs scripts/auth-ui-test.mjs",
    "test:gateway": "node --no-warnings scripts/gateway-auth-test.mjs",
    "test:readsync": "node --import ./scripts/register-css-stub.mjs scripts/readsync-test.mjs",
    "test:designer": "node --import ./scripts/register-css-stub.mjs scripts/designer-test.mjs",
    "test:skills": "node --import ./scripts/register-css-stub.mjs scripts/skills-test.mjs",
    "test:comms": "node --import ./scripts/register-css-stub.mjs scripts/comms-test.mjs",
    "test:responsive": "node --import ./scripts/register-css-stub.mjs scripts/responsive-test.mjs",
    "test:local": "node --import ./scripts/register-css-stub.mjs scripts/local-test.mjs",
    "test:kanban": "node --import ./scripts/register-css-stub.mjs scripts/kanban-test.mjs",
    "test:comms-gateway": "node --no-warnings scripts/comms-gateway-test.mjs",
    "test:local-runtime": "node scripts/local-runtime-test.mjs",
    "test:local-spike:browser": "node scripts/local-spike-browser-test.mjs",
    "test:isolation": "node scripts/isolation-test.mjs",
    "test:isolation:browser": "node scripts/isolation-browser-test.mjs",
    "test:session-safety": "node --import ./scripts/register-css-stub.mjs scripts/session-safety-test.mjs",
    "test:sw-safety": "node scripts/service-worker-safety-test.mjs",
    "test:provider-safety": "node scripts/provider-safety-test.mjs",
    "test:comms-persistence": "node scripts/comms-persistence-test.mjs",
    "test:sw-safety:browser": "node scripts/service-worker-browser-test.mjs",
    "test:training-jsonl": "node scripts/training-jsonl-test.mjs",
    "test:relay:browser": "node scripts/relay-browser-test.mjs",
    "test:design": "node scripts/design-system-test.mjs",
    "test:scroll": "node --import ./scripts/register-css-stub.mjs scripts/scroll-test.mjs",
    "test:scroll:browser": "node scripts/scroll-browser-test.mjs",
    "test:voice": "node --import ./scripts/register-css-stub.mjs scripts/voice-test.mjs",
    "test:voice:browser": "node scripts/voice-browser-test.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "happy-dom": "^21.0.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vercel": "^64.0.2",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@wllama/wllama": "3.8.1",
